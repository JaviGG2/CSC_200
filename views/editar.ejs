<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#ffffff">
  <title>Editar registro | Comuna Carabobo 200</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('partials/topbar', { activo: 'censo' }) %>

  <main class="contenedor pagina">
    <% if (error) { %>
      <div class="alerta alerta--error" role="alert"><%= error %></div>
    <% } %>

    <section class="panel" id="editar-registro">
      <div class="panel-head panel-head--fila">
        <div>
          <h2>Editar registro N.º <%= registro.id %></h2>
          <p>Actualice los datos y guarde los cambios.</p>
        </div>
        <a href="/#registro-<%= registro.id %>" class="boton boton--mini boton--secundario">Volver</a>
      </div>

      <form action="/registros/<%= registro.id %>/editar" method="post" class="formulario" data-bloquear>
        <div class="grupo">
          <h3 class="grupo-titulo">Datos personales</h3>

          <div class="campos">
            <div class="campo">
              <label for="cedula">Cédula <span class="requerido">*</span></label>
              <input
                type="text"
                id="cedula"
                name="cedula"
                value="<%= valores.cedula || '' %>"
                placeholder="V-12345678"
                maxlength="30"
                autocomplete="off"
                required
              >
            </div>

            <div class="campos-dobles">
              <div class="campo">
                <label for="nombres">Nombres <span class="requerido">*</span></label>
                <input
                  type="text"
                  id="nombres"
                  name="nombres"
                  value="<%= valores.nombres || '' %>"
                  maxlength="120"
                  autocomplete="given-name"
                  required
                >
              </div>

              <div class="campo">
                <label for="apellidos">Apellidos <span class="requerido">*</span></label>
                <input
                  type="text"
                  id="apellidos"
                  name="apellidos"
                  value="<%= valores.apellidos || '' %>"
                  maxlength="120"
                  autocomplete="family-name"
                  required
                >
              </div>
            </div>

            <div class="campo">
              <label for="fecha_nacimiento">Fecha de nacimiento</label>
              <input
                type="date"
                id="fecha_nacimiento"
                name="fecha_nacimiento"
                value="<%= (valores.fecha_nacimiento || '').slice(0, 10) %>"
              >
              <p class="ayuda">Si se deja vacía, se conserva la fecha actual del registro.</p>
            </div>
        </div>
      </div>

        <div class="grupo">
          <div class="grupo-head">
            <h3 class="grupo-titulo">Datos del censo</h3>
            <div class="grupo-acciones">
              <a href="/campos" class="boton-campo">Administrar campos</a>
            </div>
          </div>

          <div class="campos">
            <% campos.forEach(function (campo) { %>
              <div class="campo">
                <label for="campo-<%= campo.clave %>">
                  <%= campo.etiqueta %>
                  <% if (campo.requerido) { %><span class="requerido">*</span><% } %>
                </label>

                <% if (campo.tipo === 'textarea') { %>
                  <textarea
                    id="campo-<%= campo.clave %>"
                    name="<%= campo.clave %>"
                    rows="3"
                    maxlength="4000"
                    <% if (campo.requerido) { %>required<% } %>
                  ><%= valores[campo.clave] || '' %></textarea>
                <% } else if (campo.tipo === 'select') { %>
                  <select
                    id="campo-<%= campo.clave %>"
                    name="<%= campo.clave %>"
                    <% if (campo.requerido) { %>required<% } %>
                  >
                    <option value="">Seleccione...</option>
                    <% campo.opciones.forEach(function (opcion) { %>
                      <option value="<%= opcion %>" <% if (String(valores[campo.clave] || '') === String(opcion)) { %>selected<% } %>><%= opcion %></option>
                    <% }); %>
                  </select>
                <% } else { %>
                  <input
                    type="<%= campo.tipo %>"
                    id="campo-<%= campo.clave %>"
                    name="<%= campo.clave %>"
                    value="<%= valores[campo.clave] || '' %>"
                    maxlength="4000"
                    <% if (campo.tipo === 'number') { %>step="any" inputmode="decimal"<% } %>
                    <% if (campo.requerido) { %>required<% } %>
                  >
                <% } %>
              </div>
            <% }); %>
          </div>
        </div>

        <div class="acciones-form acciones-form--fila">
          <button type="submit" class="boton boton--primario">Guardar cambios</button>
          <a href="/#registro-<%= registro.id %>" class="boton boton--secundario">Cancelar</a>
        </div>
      </form>
    </section>
  </main>

  <footer class="pie">
    <div class="contenedor">
      Comuna Socialista Carabobo 200 · Censo local
    </div>
  </footer>

  <script src="/app.js" defer></script>
</body>
</html>
