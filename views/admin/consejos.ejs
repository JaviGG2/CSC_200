<%
  const usuarioActual = typeof usuario !== 'undefined' ? usuario : null;
  const config = typeof configNeon !== 'undefined' ? configNeon : null;
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#ffffff">
  <title>Consejos comunales | Administración</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('../partials/topbar') %>

  <main class="contenedor pagina">
    <%- include('../partials/admin-nav') %>

    <% if (ok) { %><div class="alerta alerta--exito" role="status"><%= ok %></div><% } %>
    <% if (error) { %><div class="alerta alerta--error" role="alert"><%= error %></div><% } %>

    <section class="panel">
      <div class="panel-head panel-head--fila">
        <div>
          <h2>Catálogo de consejos comunales</h2>
          <p>
            Los consejos activos alimentan el filtro del Censo y el formulario de registro.
            Los cambios se guardan en Neon y se reflejan a todos los usuarios.
          </p>
        </div>
        <% if (config) { %>
          <span class="insignia <%= config.ok ? 'insignia--sincronizado' : 'insignia--pendiente' %>">
            <%= config.ok ? 'Sincronizado con Neon' : 'Sin conexión a Neon' %>
          </span>
        <% } %>
      </div>

      <form method="post" action="/admin/consejos" class="formulario formulario--compacto">
        <div class="campos">
          <div class="campo">
            <label for="nuevo-consejo-nombre">Nombre del consejo <span class="requerido">*</span></label>
            <input
              type="text"
              id="nuevo-consejo-nombre"
              name="nombre"
              maxlength="160"
              placeholder="Ej.: Consejo Comunal Carabobo 200"
              required
            >
          </div>
          <div class="campo">
            <label for="nuevo-consejo-sector">Sector o etapa</label>
            <input type="text" id="nuevo-consejo-sector" name="sector" maxlength="160" placeholder="Ej.: Etapa 1">
          </div>
          <div class="campo">
            <label for="nuevo-consejo-activo">Estado</label>
            <select id="nuevo-consejo-activo" name="activo">
              <option value="1" selected>Activo</option>
              <option value="0">Inactivo</option>
            </select>
          </div>
        </div>
        <div class="acciones-form--fila">
          <button type="submit" class="boton boton--primario">Agregar consejo comunal</button>
        </div>
      </form>
    </section>

    <section class="panel">
      <div class="panel-head">
        <h2>Consejos registrados</h2>
        <p><%= consejos.length %> consejo(s). Los inactivos no aparecen en el formulario.</p>
      </div>

      <% if (!consejos.length) { %>
        <div class="estado-vacio">
          <strong>No hay consejos comunales.</strong>
          <p>Cree el primero con el formulario superior.</p>
        </div>
      <% } else { %>
        <div class="tabla-scroll">
          <table class="tabla-personas">
            <thead>
              <tr>
                <th scope="col">Consejo comunal</th>
                <th scope="col">Sector</th>
                <th scope="col">Estado</th>
                <th scope="col">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% consejos.forEach(function (consejo) { %>
                <tr>
                  <td>
                    <input
                      form="consejo-<%= consejo.id %>"
                      type="text"
                      name="nombre"
                      value="<%= consejo.nombre %>"
                      class="input-tabla"
                      maxlength="160"
                      required
                    >
                  </td>
                  <td>
                    <input
                      form="consejo-<%= consejo.id %>"
                      type="text"
                      name="sector"
                      value="<%= consejo.sector || '' %>"
                      class="input-tabla"
                      maxlength="160"
                    >
                  </td>
                  <td>
                    <label class="check-inline">
                      <input
                        form="consejo-<%= consejo.id %>"
                        type="checkbox"
                        name="activo"
                        value="1"
                        <%= consejo.activo ? 'checked' : '' %>
                      >
                      <%= consejo.activo ? 'Activo' : 'Inactivo' %>
                    </label>
                  </td>
                  <td class="col-acciones">
                    <div class="acciones-fila">
                      <button form="consejo-<%= consejo.id %>" type="submit" class="boton boton--mini boton--primario">Guardar</button>
                      <form method="post" action="/admin/consejos/<%= consejo.id %>/estado" style="display:inline;">
                        <button type="submit" class="boton boton--mini boton--secundario">
                          <%= consejo.activo ? 'Desactivar' : 'Activar' %>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <% consejos.forEach(function (consejo) { %>
          <form id="consejo-<%= consejo.id %>" method="post" action="/admin/consejos/<%= consejo.id %>/editar"></form>
        <% }); %>
      <% } %>
    </section>
  </main>

  <footer class="pie">
    <div class="contenedor">Comuna Socialista Carabobo 200 · Consejos comunales</div>
  </footer>
</body>
</html>
