<%
  const config = typeof configNeon !== 'undefined' ? configNeon : null;
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#ffffff">
  <title>Territorio | Administración</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('../partials/topbar', { activo: 'admin' }) %>

  <main class="contenedor pagina">
    <%- include('../partials/admin-nav') %>

    <% if (ok) { %><div class="alerta alerta--exito" role="status"><%= ok %></div><% } %>
    <% if (error) { %><div class="alerta alerta--error" role="alert"><%= error %></div><% } %>

    <section class="panel">
      <div class="panel-head panel-head--fila">
        <div>
          <h2>Gestión de Territorio</h2>
          <p>Estados, municipios, parroquias, comunidades, etapas y manzanas disponibles en el censo.</p>
        </div>
        <% if (config) { %>
          <span class="insignia <%= config.ok ? 'insignia--sincronizado' : 'insignia--pendiente' %>">
            <%= config.ok ? 'Sincronizado con Neon' : 'Sin conexión a Neon' %>
          </span>
        <% } %>
      </div>

      <form method="post" action="/admin/territorio" class="formulario">
        <div class="campos">
          <div class="campos-dobles">
            <div class="campo">
              <label for="tipo-territorio">Nivel territorial <span class="requerido">*</span></label>
              <select id="tipo-territorio" name="tipo" required>
                <option value="">Seleccione un nivel...</option>
                <option value="estado">Estado</option>
                <option value="municipio">Municipio</option>
                <option value="parroquia">Parroquia</option>
                <option value="comunidad">Comunidad</option>
                <option value="etapa">Etapa</option>
                <option value="manzana">Manzana</option>
              </select>
            </div>
            <div class="campo">
              <label for="nombre-territorio">Nombre <span class="requerido">*</span></label>
              <input
                type="text"
                id="nombre-territorio"
                name="nombre"
                maxlength="120"
                placeholder="Ej.: Comunidad 20 de Julio, Etapa 4, Manzana A"
                required
              >
            </div>
          </div>

          <div class="campos-dobles">
            <div class="campo">
              <label for="padre-territorio">Pertenece a (opcional)</label>
              <select id="padre-territorio" name="padre_id">
                <option value="">— Ninguno (nivel independiente) —</option>
                <% territorios.forEach(function (padre) { %>
                  <option value="<%= padre.id %>"><%= padre.tipo %> · <%= padre.nombre %></option>
                <% }); %>
              </select>
            </div>
            <div class="campo">
              <label for="activo-territorio">Estado</label>
              <select id="activo-territorio" name="activo">
                <option value="1" selected>Activo</option>
                <option value="0">Inactivo</option>
              </select>
            </div>
          </div>
          <p class="ayuda">Los elementos activos aparecen inmediatamente en el formulario de registro de viviendas.</p>
        </div>

        <div class="acciones-form--fila">
          <button type="submit" class="boton boton--primario">Agregar territorio</button>
        </div>
      </form>
    </section>

    <section class="panel">
      <div class="panel-head">
        <h2>Territorios registrados</h2>
        <p><%= territorios.length %> elemento(s).</p>
      </div>

      <div class="tabla-scroll">
        <table class="tabla-personas">
          <thead>
            <tr>
              <th>Tipo</th>
              <th>Nombre</th>
              <th>Pertenece a</th>
              <th>Activo</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% territorios.forEach(function (t) { %>
              <tr>
                <td><span class="tipo-badge"><%= t.tipo %></span></td>
                <td>
                  <input form="terr-<%= t.id %>" type="text" name="nombre" value="<%= t.nombre %>" class="input-tabla" required>
                </td>
                <td>
                  <select form="terr-<%= t.id %>" name="padre_id" class="input-tabla">
                    <option value="">— Ninguno —</option>
                    <% territorios.forEach(function (padre) { %>
                      <% if (padre.id !== t.id) { %>
                        <option value="<%= padre.id %>" <%= t.padre_id === padre.id ? 'selected' : '' %>><%= padre.tipo %> · <%= padre.nombre %></option>
                      <% } %>
                    <% }); %>
                  </select>
                </td>
                <td>
                  <label class="check-inline">
                    <input form="terr-<%= t.id %>" type="checkbox" name="activo" value="1" <%= t.activo ? 'checked' : '' %>>
                    Activo
                  </label>
                </td>
                <td class="col-acciones">
                  <div class="acciones-fila">
                    <button form="terr-<%= t.id %>" type="submit" class="boton boton--mini boton--primario">Guardar</button>
                    <form
                      method="post"
                      action="/admin/territorio/<%= t.id %>/eliminar"
                      data-confirmar="¿Eliminar <%= t.tipo %> «<%= t.nombre %>»?"
                      data-confirmar-titulo="Eliminar territorio"
                      data-confirmar-boton="Eliminar"
                    >
                      <button type="submit" class="boton boton--mini boton--peligro">Eliminar</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <% territorios.forEach(function (t) { %>
        <form id="terr-<%= t.id %>" method="post" action="/admin/territorio/<%= t.id %>/editar"></form>
      <% }); %>
    </section>
  </main>

  <footer class="pie">
    <div class="contenedor">Comuna Socialista Carabobo 200 · Territorio</div>
  </footer>

  <%- include('../partials/dialogo-confirmacion') %>
  <script src="/popups.js" defer></script>
</body>
</html>
