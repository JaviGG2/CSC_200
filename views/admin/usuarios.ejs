<%
  const config = typeof configNeon !== 'undefined' ? configNeon : null;
  const estadoIngresos = typeof estadisticasIngresos !== 'undefined'
    ? estadisticasIngresos
    : { total_ingresos: 0, personas_unicas: 0, ingresos_hoy: 0, activos_ahora: 0, total_cuentas: usuarios.length, ultimo_ingreso: null };
  const ingresosLista = typeof ingresosRecientes !== 'undefined' ? ingresosRecientes : [];
  const fmtFecha = typeof formatearFecha === 'function' ? formatearFecha : (v) => (v || '—');
  const etiquetaModulo = (mod) => {
    if (mod === 'socioeconomico') return 'Socio-Demográfico';
    if (mod === 'medicos') return 'Expedientes Médicos';
    if (mod === 'beneficios') return 'Beneficios';
    return 'Portal';
  };
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#ffffff">
  <title>Usuarios | Administración</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('../partials/topbar', { activo: 'admin' }) %>

  <main class="contenedor pagina">
    <%- include('../partials/admin-nav') %>

    <% if (ok) { %><div class="alerta alerta--exito"><%= ok %></div><% } %>
    <% if (error) { %><div class="alerta alerta--error"><%= error %></div><% } %>

    <section class="panel" id="status-people">
      <div class="panel-head panel-head--fila">
        <div>
          <h2>Status People</h2>
          <p>Control de personas que han ingresado al sistema.</p>
        </div>
        <span class="contador">
          <%= estadoIngresos.personas_unicas %> / <%= estadoIngresos.total_cuentas %> cuentas
        </span>
      </div>

      <div class="status-people-grid">
        <div class="status-people-dato">
          <span class="status-people-label">Personas que ingresaron</span>
          <strong class="status-people-valor"><%= estadoIngresos.personas_unicas %></strong>
        </div>
        <div class="status-people-dato">
          <span class="status-people-label">Activos ahora</span>
          <strong class="status-people-valor"><%= estadoIngresos.activos_ahora %></strong>
        </div>
        <div class="status-people-dato">
          <span class="status-people-label">Ingresos hoy</span>
          <strong class="status-people-valor"><%= estadoIngresos.ingresos_hoy %></strong>
        </div>
        <div class="status-people-dato">
          <span class="status-people-label">Total de ingresos</span>
          <strong class="status-people-valor"><%= estadoIngresos.total_ingresos %></strong>
        </div>
      </div>
    </section>

    <section class="panel">
      <div class="panel-head panel-head--fila">
        <div>
          <h2>Crear usuario</h2>
        </div>
        <% if (config) { %>
          <span class="insignia <%= config.ok ? 'insignia--sincronizado' : 'insignia--pendiente' %>">
            <%= config.ok ? 'Sincronizado con Neon' : 'Sin conexión a Neon' %>
          </span>
        <% } %>
      </div>

      <form method="post" action="/admin/usuarios" class="formulario">
        <div class="campos">
          <div class="campos-dobles">
            <div class="campo">
              <label for="nuevo-usuario">Usuario</label>
              <input type="text" id="nuevo-usuario" name="usuario" placeholder="ej.: gestor1" required>
            </div>
            <div class="campo">
              <label for="nuevo-nombre">Nombre completo</label>
              <input type="text" id="nuevo-nombre" name="nombre" placeholder="Nombre y apellido" required>
            </div>
          </div>

          <div class="campos-dobles">
            <div class="campo">
              <label for="nuevo-clave">Contraseña</label>
              <input type="password" id="nuevo-clave" name="clave" minlength="4" required>
            </div>
            <div class="campo">
              <label for="nuevo-rol">Rol</label>
              <select id="nuevo-rol" name="rol">
                <option value="gestor">Gestor (empadronador)</option>
                <option value="admin">Administrador</option>
              </select>
            </div>
          </div>
        </div>

        <div class="acciones-form--fila">
          <button type="submit" class="boton boton--primario">Crear usuario</button>
        </div>
      </form>
    </section>

    <section class="panel">
      <div class="panel-head">
        <h2>Usuarios existentes</h2>
        <p><%= usuarios.length %> cuenta(s) registrada(s).</p>
      </div>

      <div class="tabla-scroll">
        <table class="tabla-personas">
          <thead>
            <tr>
              <th>Usuario</th>
              <th>Nombre</th>
              <th>Rol</th>
              <th>Sesión</th>
              <th>Ingresos</th>
              <th>Último ingreso</th>
              <th>Estado</th>
              <th>Nueva contraseña</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% usuarios.forEach(function (u) { %>
              <tr>
                <td><strong><%= u.usuario %></strong></td>
                <td>
                  <input form="edit-<%= u.id %>" type="text" name="nombre" value="<%= u.nombre %>" class="input-tabla" required>
                </td>
                <td>
                  <select form="edit-<%= u.id %>" name="rol" class="input-tabla">
                    <option value="gestor" <%= u.rol === 'gestor' ? 'selected' : '' %>>Gestor</option>
                    <option value="admin" <%= u.rol === 'admin' ? 'selected' : '' %>>Admin</option>
                  </select>
                </td>
                <td>
                  <span class="insignia <%= u.en_linea ? 'insignia--sincronizado' : 'insignia--local' %>">
                    <%= u.en_linea ? 'En línea' : 'Sin sesión' %>
                  </span>
                </td>
                <td class="col-id"><strong><%= u.total_ingresos || 0 %></strong></td>
                <td class="col-fecha"><%= u.ultimo_ingreso ? fmtFecha(u.ultimo_ingreso) : 'Nunca' %></td>
                <td>
                  <label class="check-inline">
                    <input form="edit-<%= u.id %>" type="checkbox" name="activo" value="1" <%= u.activo ? 'checked' : '' %>>
                    Activo
                  </label>
                </td>
                <td>
                  <input form="edit-<%= u.id %>" type="password" name="clave" placeholder="(sin cambios)" class="input-tabla" minlength="4">
                </td>
                <td class="col-acciones">
                  <div class="acciones-fila">
                    <button form="edit-<%= u.id %>" type="submit" class="boton boton--mini boton--primario">Guardar</button>
                    <% if (!usuarioSesion || usuarioSesion.id !== u.id) { %>
                      <form
                        method="post"
                        action="/admin/usuarios/<%= u.id %>/eliminar"
                        data-confirmar="¿Eliminar el usuario «<%= u.usuario %>»?"
                        data-confirmar-titulo="Eliminar usuario"
                        data-confirmar-boton="Eliminar usuario"
                      >
                        <button type="submit" class="boton boton--mini boton--peligro">Eliminar</button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <% usuarios.forEach(function (u) { %>
        <form id="edit-<%= u.id %>" method="post" action="/admin/usuarios/<%= u.id %>/editar"></form>
      <% }); %>
    </section>

    <section class="panel" id="accesos">
      <div class="panel-head panel-head--fila">
        <div>
          <h2>Ingresos recientes</h2>
          <p>Últimos <%= ingresosLista.length %> accesos registrados.</p>
        </div>
      </div>

      <div class="tabla-scroll">
        <table class="tabla-personas">
          <thead>
            <tr>
              <th>Persona</th>
              <th>Rol</th>
              <th>Módulo</th>
              <th>Fecha y hora</th>
            </tr>
          </thead>
          <tbody>
            <% if (!ingresosLista.length) { %>
              <tr>
                <td colspan="4" class="tabla-vacia">
                  <strong>Sin ingresos registrados</strong>
                  <span>Los accesos aparecerán aquí cuando los usuarios inicien sesión.</span>
                </td>
              </tr>
            <% } else { %>
              <% ingresosLista.forEach(function (item) { %>
                <tr>
                  <td class="col-persona">
                    <strong><%= item.nombre %></strong>
                    <span>@<%= item.usuario %></span>
                  </td>
                  <td>
                    <span class="insignia <%= item.rol === 'admin' ? 'insignia--sincronizado' : 'insignia--local' %>">
                      <%= item.rol === 'admin' ? 'Administrador' : 'Gestor' %>
                    </span>
                  </td>
                  <td class="col-dato"><%= etiquetaModulo(item.modulo) %></td>
                  <td class="col-fecha"><%= fmtFecha(item.fecha_ingreso) %></td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <footer class="pie">
    <div class="contenedor">Comuna Socialista Carabobo 200 · Usuarios</div>
  </footer>

  <%- include('../partials/dialogo-confirmacion') %>
  <script src="/popups.js" defer></script>
</body>
</html>
