<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#ffffff">
  <title>Registros por sector | Comuna Carabobo 200</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="topbar">
    <div class="contenedor topbar-inner">
      <div class="brand">
        <span class="brand-mark" aria-hidden="true">C200</span>
        <div class="brand-text">
          <h1>Comuna Carabobo 200</h1>
          <p>Censo sociodemográfico y médico</p>
        </div>
      </div>
      <nav class="topbar-nav" aria-label="Secciones">
        <a href="/" class="topbar-link">Censo</a>
        <a href="/sectores" class="topbar-link" aria-current="page">Sectores</a>
      </nav>
      <span class="offline">
        <span class="offline-dot" aria-hidden="true"></span>
        Modo offline
      </span>
    </div>
  </header>

  <main class="contenedor pagina">
    <div class="pagina-cabecera">
      <div>
        <h1>Registros por sector</h1>
        <p>Cada sector muestra su propia tabla con los campos del censo.</p>
      </div>
      <div class="pagina-cabecera-acciones">
        <a href="/sectores/administrar" class="boton boton--secundario">Administrar sectores</a>
        <a href="/" class="boton boton--secundario">Volver al censo</a>
      </div>
    </div>

    <% if (ok) { %>
      <div class="alerta alerta--exito" role="status"><%= ok %></div>
    <% } %>

    <% if (error) { %>
      <div class="alerta alerta--error" role="alert"><%= error %></div>
    <% } %>

    <div class="resumen">
      <span><strong><%= secciones.length %></strong> sectores</span>
      <span><strong><%= totalRegistros %></strong> registros</span>
      <% if (sinSector.length) { %>
        <span><strong><%= sinSector.length %></strong> sin sector</span>
      <% } %>
    </div>

    <% if (!secciones.length && !sinSector.length) { %>
      <section class="panel">
        <div class="lista-vacia">
          <strong>No hay sectores ni registros todavía.</strong>
          <span>Cree un sector y luego registre el primer censo.</span>
          <p class="lista-vacia-acciones">
            <a href="/sectores/administrar" class="boton boton--primario">Crear sector</a>
          </p>
        </div>
      </section>
    <% } %>

    <div class="lista-sectores">
      <% secciones.forEach(function (sector) { %>
        <section
          class="panel panel--sector"
          id="sector-<%= sector.id %>"
          data-sector-panel
        >
          <div class="panel-head panel-head--fila">
            <div>
              <h2>
                <%= sector.nombre %>
                <% if (!sector.activo) { %>
                  <span class="estado estado--oculto">Oculto</span>
                <% } %>
              </h2>
              <p><%= sector.registros.length %> registro<%= sector.registros.length === 1 ? '' : 's' %> en este sector.</p>
            </div>
            <div class="panel-head-acciones no-imprimir">
              <button
                type="button"
                class="boton boton--mini boton--secundario"
                data-imprimir-sector="sector-<%= sector.id %>"
              >Imprimir</button>
              <a
                href="/sectores/<%= sector.id %>/exportar.csv"
                class="boton boton--mini boton--secundario"
              >CSV</a>
            </div>
          </div>

          <% if (!sector.registros.length) { %>
            <div class="lista-vacia">
              <strong>Sin registros en este sector.</strong>
              <span>Registre un censo y seleccione este sector.</span>
            </div>
          <% } else { %>
            <div class="tabla-scroll">
              <table class="tabla-sector">
                <thead>
                  <tr>
                    <th scope="col">N.º</th>
                    <th scope="col">Cédula</th>
                    <th scope="col">Nombres</th>
                    <th scope="col">Apellidos</th>
                    <th scope="col">Fecha</th>
                    <% campos.forEach(function (campo) { %>
                      <th scope="col"><%= campo.etiqueta %></th>
                    <% }); %>
                    <th scope="col">Estado</th>
                    <th scope="col" class="no-imprimir">Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  <% sector.registros.forEach(function (registro) { %>
                    <tr id="registro-<%= registro.id %>">
                      <td class="col-id"><%= registro.id %></td>
                      <td><span class="cedula"><%= registro.cedula %></span></td>
                      <td><%= registro.nombres %></td>
                      <td><%= registro.apellidos %></td>
                      <td class="col-fecha"><%= formatoFecha(registro.fecha_registro) %></td>
                      <% campos.forEach(function (campo) { %>
                        <td class="col-dato"><%= registro.valores[campo.clave] || '—' %></td>
                      <% }); %>
                      <td>
                        <% if (registro.sincronizado) { %>
                          <span class="insignia insignia--sincronizado">Sincronizado</span>
                        <% } else { %>
                          <span class="insignia insignia--pendiente">Pendiente</span>
                        <% } %>
                      </td>
                      <td class="no-imprimir">
                        <a
                          href="/registros/<%= registro.id %>/editar"
                          class="boton boton--mini boton--secundario"
                        >Editar</a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </section>
      <% }); %>

      <% if (sinSector.length) { %>
        <section class="panel panel--sector" id="sector-sin-sector" data-sector-panel>
          <div class="panel-head panel-head--fila">
            <div>
              <h2>Sin sector</h2>
              <p><%= sinSector.length %> registro<%= sinSector.length === 1 ? '' : 's' %> sin sector asignado.</p>
            </div>
            <div class="panel-head-acciones no-imprimir">
              <button
                type="button"
                class="boton boton--mini boton--secundario"
                data-imprimir-sector="sector-sin-sector"
              >Imprimir</button>
              <a
                href="/sectores/sin-sector/exportar.csv"
                class="boton boton--mini boton--secundario"
              >CSV</a>
            </div>
          </div>

          <div class="tabla-scroll">
            <table class="tabla-sector">
              <thead>
                <tr>
                  <th scope="col">N.º</th>
                  <th scope="col">Cédula</th>
                  <th scope="col">Nombres</th>
                  <th scope="col">Apellidos</th>
                  <th scope="col">Fecha</th>
                  <% campos.forEach(function (campo) { %>
                    <th scope="col"><%= campo.etiqueta %></th>
                  <% }); %>
                  <th scope="col">Estado</th>
                  <th scope="col" class="no-imprimir">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% sinSector.forEach(function (registro) { %>
                  <tr id="registro-<%= registro.id %>">
                    <td class="col-id"><%= registro.id %></td>
                    <td><span class="cedula"><%= registro.cedula %></span></td>
                    <td><%= registro.nombres %></td>
                    <td><%= registro.apellidos %></td>
                    <td class="col-fecha"><%= formatoFecha(registro.fecha_registro) %></td>
                    <% campos.forEach(function (campo) { %>
                      <td class="col-dato"><%= registro.valores[campo.clave] || '—' %></td>
                    <% }); %>
                    <td>
                      <% if (registro.sincronizado) { %>
                        <span class="insignia insignia--sincronizado">Sincronizado</span>
                      <% } else { %>
                        <span class="insignia insignia--pendiente">Pendiente</span>
                      <% } %>
                    </td>
                    <td class="no-imprimir">
                      <a
                        href="/registros/<%= registro.id %>/editar"
                        class="boton boton--mini boton--secundario"
                      >Editar</a>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </section>
      <% } %>
    </div>
  </main>

  <footer class="pie">
    <div class="contenedor">
      Comuna Socialista Carabobo 200 · Censo local
    </div>
  </footer>

  <script src="/app.js" defer></script>
</body>
</html>
