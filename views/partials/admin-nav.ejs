<%
  const rutaAdmin = typeof ruta !== 'undefined' ? ruta : '';
  const itemsAdmin = [
    { href: '/admin', etiqueta: 'Resumen', exacto: true },
    { href: '/admin/consejos', etiqueta: 'Consejos comunales' },
    { href: '/admin/opciones', etiqueta: 'Opciones de campos' },
    { href: '/admin/formulario', etiqueta: 'Formulario' },
    { href: '/admin/territorio', etiqueta: 'Territorio y sectores' },
    { href: '/admin/usuarios', etiqueta: 'Usuarios' },
    { href: '/campos', etiqueta: 'Campos adicionales' },
  ];
  const esActivo = (item) => (item.exacto ? rutaAdmin === item.href : rutaAdmin.startsWith(item.href));
  const itemActivo = itemsAdmin.find(esActivo) || itemsAdmin[0];
%>
<div class="menu-desplegable menu-desplegable--movil menu-desplegable--admin" data-menu-desplegable>
  <button
    type="button"
    class="boton boton--secundario menu-desplegable-trigger menu-desplegable-trigger--ancho"
    data-menu-trigger
    aria-expanded="false"
    aria-haspopup="true"
  >
    <span>Sección: <strong><%= itemActivo.etiqueta %></strong></span>
    <span class="menu-desplegable-caret" aria-hidden="true">▾</span>
  </button>

  <nav class="admin-nav menu-desplegable-panel" data-menu-panel aria-label="Administración">
    <% itemsAdmin.forEach(function (item) { %>
      <a
        href="<%= item.href %>"
        class="admin-nav-link<%= esActivo(item) ? ' admin-nav-link--activo' : '' %>"
        <%= esActivo(item) ? 'aria-current="page"' : '' %>
      ><%= item.etiqueta %></a>
    <% }); %>
  </nav>
</div>
