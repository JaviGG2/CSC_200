<%
  const rutaAdmin = typeof ruta !== 'undefined' ? ruta : '';
  const enlaceAdmin = (href, etiqueta) => {
    const activo = href === '/admin' ? rutaAdmin === '/admin' : rutaAdmin.startsWith(href);
    return `<a href="${href}" class="admin-nav-link${activo ? ' admin-nav-link--activo' : ''}"${activo ? ' aria-current="page"' : ''}>${etiqueta}</a>`;
  };
%>
<nav class="admin-nav" aria-label="Administración">
  <%- enlaceAdmin('/admin', 'Resumen') %>
  <%- enlaceAdmin('/admin/consejos', 'Consejos comunales') %>
  <%- enlaceAdmin('/admin/opciones', 'Opciones de campos') %>
  <%- enlaceAdmin('/admin/formulario', 'Formulario') %>
  <%- enlaceAdmin('/admin/territorio', 'Territorio y sectores') %>
  <%- enlaceAdmin('/admin/usuarios', 'Usuarios') %>
  <a href="/campos" class="admin-nav-link">Campos adicionales</a>
</nav>
