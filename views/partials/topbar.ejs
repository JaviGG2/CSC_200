<header class="topbar">
  <div class="contenedor topbar-inner">
    <div class="brand">
      <span class="brand-mark" aria-hidden="true">C200</span>
      <div class="brand-text">
        <h1>Comuna Carabobo 200</h1>
        <p>Registro demográfico y socioeconómico</p>
      </div>
    </div>

    <nav class="topbar-nav" aria-label="Secciones">
      <a href="/" class="topbar-link <%= typeof activo !== 'undefined' && activo === 'censo' ? 'topbar-link--activo' : '' %>">Censo</a>
      <a href="/wizard" class="topbar-link <%= typeof activo !== 'undefined' && activo === 'wizard' ? 'topbar-link--activo' : '' %>">Nueva Vivienda</a>
      <a href="/personas" class="topbar-link <%= typeof activo !== 'undefined' && activo === 'personas' ? 'topbar-link--activo' : '' %>">Personas</a>
      <a href="/ubicacion" class="topbar-link <%= typeof activo !== 'undefined' && activo === 'ubicacion' ? 'topbar-link--activo' : '' %>">Por Ubicación</a>
      <% if (typeof usuario !== 'undefined' && usuario && usuario.rol === 'admin') { %>
        <a href="/admin" class="topbar-link <%= typeof activo !== 'undefined' && activo === 'admin' ? 'topbar-link--activo' : '' %>">Administración</a>
      <% } %>
    </nav>

    <% if (typeof usuario !== 'undefined' && usuario) { %>
      <div class="topbar-usuario">
        <span class="usuario-nombre" title="<%= usuario.usuario %>">
          <%= usuario.nombre %> · <%= usuario.rol === 'admin' ? 'Admin' : 'Gestor' %>
        </span>
        <form method="post" action="/logout" class="logout-form">
          <button type="submit" class="boton boton--mini boton--secundario">Salir</button>
        </form>
      </div>
    <% } %>
  </div>
</header>
