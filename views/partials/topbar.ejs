<%
  const moduloActual = typeof modulo !== 'undefined' ? modulo : 'censo';
  const subseccionActual = typeof subseccion !== 'undefined' ? subseccion : (typeof activo !== 'undefined' ? activo : 'inicio');
  const usuarioActual = typeof usuario !== 'undefined' ? usuario : null;
  const esAdminActual = typeof esAdmin !== 'undefined' ? esAdmin : Boolean(usuarioActual && usuarioActual.rol === 'admin');

  const titulosModulo = {
    portal: { nombre: 'Portal de Módulos', ruta: '/inicio' },
    censo: { nombre: 'Socio-Demográfico', ruta: '/censo' },
    expedientes: { nombre: 'Expedientes Médicos', ruta: '/expedientes-medicos' },
    beneficios: { nombre: 'Beneficios', ruta: '/beneficios' },
  };
  const infoModulo = titulosModulo[moduloActual] || titulosModulo.censo;
%>
<header class="app-header">
  <div class="app-header-main">
    <div class="contenedor app-header-inner">
      <a class="brand" href="<%= infoModulo.ruta %>" aria-label="Inicio de <%= infoModulo.nombre %>">
        <img
          src="/assets/aistudio/WhatsApp_Image_2026-10-24_at_4.01.50_PM-Photoroom_c9a67c8e.png"
          alt="Logo Comuna Socialista Carabobo 200"
          class="brand-logo"
          width="42"
          height="42"
        >
        <span class="brand-text">
          <strong>Comuna Carabobo 200</strong>
        </span>
      </a>

      <span class="modulo-actual-ruta">
        <strong><%= infoModulo.nombre %></strong>
      </span>

      <div class="app-header-right">
        <% if (moduloActual !== 'portal') { %>
          <a href="/inicio" class="boton boton--mini boton--secundario">Módulos</a>
        <% } %>

        <% if (usuarioActual) { %>
          <div class="app-user">
            <span class="app-user-avatar" aria-hidden="true"><%= (usuarioActual.nombre || usuarioActual.usuario || '?').slice(0, 1).toUpperCase() %></span>
            <span class="app-user-datos">
              <strong><%= usuarioActual.nombre %></strong>
              <small><%= usuarioActual.rol === 'admin' ? 'Administrador' : 'Gestor' %></small>
            </span>
            <form method="post" action="/logout" class="logout-form">
              <button type="submit" class="boton boton--mini boton--secundario">Salir</button>
            </form>
          </div>
        <% } %>
      </div>

      <!-- Menú desplegable compacto exclusivo para móvil -->
      <div class="menu-desplegable menu-desplegable--cabecera" data-menu-desplegable>
        <button
          type="button"
          class="boton boton--mini boton--secundario menu-desplegable-trigger"
          data-menu-trigger
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span>Menú</span>
          <span class="menu-desplegable-caret" aria-hidden="true">▾</span>
        </button>

        <div class="menu-desplegable-panel menu-desplegable-panel--cabecera" data-menu-panel>
          <div class="menu-cabecera-titulo"><%= infoModulo.nombre %></div>

          <% if (moduloActual === 'censo') { %>
            <a href="/censo" class="menu-desplegable-item <%= subseccionActual === 'inicio' || subseccionActual === 'censo' ? 'menu-desplegable-item--activo' : '' %>">Inicio del censo</a>
            <a href="/wizard" class="menu-desplegable-item <%= subseccionActual === 'registro' ? 'menu-desplegable-item--activo' : '' %>">Registrar vivienda</a>
            <a href="/personas" class="menu-desplegable-item <%= subseccionActual === 'personas' ? 'menu-desplegable-item--activo' : '' %>">Padrón de personas</a>
            <a href="/ubicacion" class="menu-desplegable-item <%= subseccionActual === 'ubicacion' ? 'menu-desplegable-item--activo' : '' %>">Por ubicación</a>
            <% if (esAdminActual) { %>
              <a href="/admin" class="menu-desplegable-item <%= subseccionActual === 'admin' ? 'menu-desplegable-item--activo' : '' %>">Administración</a>
            <% } %>
          <% } else if (moduloActual === 'expedientes') { %>
            <a href="/expedientes-medicos" class="menu-desplegable-item menu-desplegable-item--activo">Listado de expedientes</a>
            <button
              type="button"
              class="menu-desplegable-item"
              data-abrir-popup="dialogo-expediente"
              data-reset-form
              data-popup-titulo="Registrar expediente médico"
              data-popup-subtitulo="Vincule el expediente a un habitante censado o ingrese los datos manualmente."
              data-popup-submit="Guardar expediente médico"
              data-popup-foco="#paciente_nombre"
            >+ Nuevo expediente</button>
          <% } else if (moduloActual === 'beneficios') { %>
            <a href="/beneficios" class="menu-desplegable-item menu-desplegable-item--activo">Historial de entregas</a>
            <button
              type="button"
              class="menu-desplegable-item"
              data-abrir-popup="dialogo-beneficio"
              data-reset-form
              data-popup-foco="#beneficiario_nombre"
            >+ Registrar entrega</button>
          <% } %>

          <% if (moduloActual !== 'portal') { %>
            <div class="menu-desplegable-sep" role="separator"></div>
            <a href="/inicio" class="menu-desplegable-item">Cambiar módulo</a>
          <% } %>

          <% if (usuarioActual) { %>
            <div class="menu-desplegable-sep" role="separator"></div>
            <div class="menu-cabecera-usuario">
              <strong><%= usuarioActual.nombre %></strong>
              <small><%= usuarioActual.rol === 'admin' ? 'Administrador' : 'Gestor' %></small>
            </div>
            <form method="post" action="/logout" class="menu-desplegable-form">
              <button type="submit" class="menu-desplegable-item menu-desplegable-item--peligro">Cerrar sesión</button>
            </form>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <% if (moduloActual === 'censo') { %>
    <div class="app-contextbar">
      <div class="contenedor app-contextbar-inner">
        <nav class="nav-censo" aria-label="Secciones del módulo Socio-Demográfico">
          <a
            href="/censo"
            class="nav-censo-link <%= subseccionActual === 'inicio' || subseccionActual === 'censo' ? 'nav-censo-link--activo' : '' %>"
            <%= subseccionActual === 'inicio' || subseccionActual === 'censo' ? 'aria-current="page"' : '' %>
          >Inicio</a>
          <a
            href="/wizard"
            class="nav-censo-link <%= subseccionActual === 'registro' ? 'nav-censo-link--activo' : '' %>"
            <%= subseccionActual === 'registro' ? 'aria-current="page"' : '' %>
          >Registrar vivienda</a>
          <a
            href="/personas"
            class="nav-censo-link <%= subseccionActual === 'personas' ? 'nav-censo-link--activo' : '' %>"
            <%= subseccionActual === 'personas' ? 'aria-current="page"' : '' %>
          >Padrón de personas</a>
          <a
            href="/ubicacion"
            class="nav-censo-link <%= subseccionActual === 'ubicacion' ? 'nav-censo-link--activo' : '' %>"
            <%= subseccionActual === 'ubicacion' ? 'aria-current="page"' : '' %>
          >Por ubicación</a>
          <% if (esAdminActual) { %>
            <a
              href="/admin"
              class="nav-censo-link <%= subseccionActual === 'admin' ? 'nav-censo-link--activo' : '' %>"
              <%= subseccionActual === 'admin' ? 'aria-current="page"' : '' %>
            >Administración</a>
          <% } %>
        </nav>
      </div>
    </div>
  <% } else if (moduloActual === 'expedientes') { %>
    <div class="app-contextbar">
      <div class="contenedor app-contextbar-inner">
        <nav class="nav-censo" aria-label="Secciones de Expedientes Médicos">
          <a href="/expedientes-medicos" class="nav-censo-link nav-censo-link--activo" aria-current="page">Expedientes</a>
          <a
            href="#dialogo-expediente"
            class="nav-censo-link"
            data-abrir-popup="dialogo-expediente"
            data-reset-form
            data-popup-titulo="Registrar expediente médico"
            data-popup-subtitulo="Vincule el expediente a un habitante censado o ingrese los datos manualmente."
            data-popup-submit="Guardar expediente médico"
            data-popup-foco="#paciente_nombre"
          >Nuevo expediente</a>
        </nav>
      </div>
    </div>
  <% } else if (moduloActual === 'beneficios') { %>
    <div class="app-contextbar">
      <div class="contenedor app-contextbar-inner">
        <nav class="nav-censo" aria-label="Secciones de Beneficios">
          <a href="/beneficios" class="nav-censo-link nav-censo-link--activo" aria-current="page">Entregas</a>
          <a
            href="#dialogo-beneficio"
            class="nav-censo-link"
            data-abrir-popup="dialogo-beneficio"
            data-reset-form
            data-popup-foco="#beneficiario_nombre"
          >Registrar entrega</a>
        </nav>
      </div>
    </div>
  <% } %>
</header>

<script>
  (function () {
    if (window.__comunaMenusInit) return;
    window.__comunaMenusInit = true;

    function cerrarTodosMenus(excepto) {
      document.querySelectorAll('[data-menu-desplegable].menu-desplegable--abierto').forEach(function (menu) {
        if (menu === excepto) return;
        menu.classList.remove('menu-desplegable--abierto');
        var btn = menu.querySelector('[data-menu-trigger]');
        if (btn) btn.setAttribute('aria-expanded', 'false');
      });
    }

    document.addEventListener('click', function (evento) {
      var trigger = evento.target.closest('[data-menu-trigger]');
      if (trigger) {
        evento.preventDefault();
        evento.stopPropagation();
        var menu = trigger.closest('[data-menu-desplegable]');
        if (!menu) return;
        var abrir = !menu.classList.contains('menu-desplegable--abierto');
        cerrarTodosMenus(abrir ? menu : null);
        menu.classList.toggle('menu-desplegable--abierto', abrir);
        trigger.setAttribute('aria-expanded', abrir ? 'true' : 'false');
        return;
      }

      var filtroBtn = evento.target.closest('[data-toggle-filtros]');
      if (filtroBtn) {
        evento.preventDefault();
        var contenedor = filtroBtn.closest('form, .ubicacion-filtros');
        if (!contenedor) return;
        var abierto = contenedor.classList.toggle('filtros--movil-abierto');
        filtroBtn.setAttribute('aria-expanded', abierto ? 'true' : 'false');
        return;
      }

      var panel = evento.target.closest('[data-menu-panel]');
      if (panel) {
        if (evento.target.closest('a, button[data-cerrar-menu], button[data-abrir-popup], button[data-abrir-password], button[data-editar-expediente], button[data-ver-expediente], button[data-ver-beneficio], button#btn-sincronizar-neon, button#btn-sincronizar-locales')) {
          cerrarTodosMenus(null);
        }
        return;
      }

      cerrarTodosMenus(null);
    });

    document.addEventListener('keydown', function (evento) {
      if (evento.key === 'Escape') cerrarTodosMenus(null);
    });
  })();
</script>
