<%
  const moduloActual = typeof modulo !== 'undefined' ? modulo : 'censo';
  const subseccionActual = typeof subseccion !== 'undefined' ? subseccion : (typeof activo !== 'undefined' ? activo : 'inicio');
  const usuarioActual = typeof usuario !== 'undefined' ? usuario : null;
  const esAdminActual = typeof esAdmin !== 'undefined' ? esAdmin : Boolean(usuarioActual && usuarioActual.rol === 'admin');

  const titulosModulo = {
    portal: { nombre: 'Portal de Módulos', ruta: '/inicio' },
    censo: { nombre: 'Socioeconómico', ruta: '/censo' },
    expedientes: { nombre: 'Expedientes Médicos', ruta: '/expedientes-medicos' },
    beneficios: { nombre: 'Beneficios', ruta: '/beneficios' },
  };
  const infoModulo = titulosModulo[moduloActual] || titulosModulo.censo;
%>
<header class="app-header">
  <div class="app-header-main">
    <div class="contenedor app-header-inner">
      <a class="brand" href="<%= infoModulo.ruta %>" aria-label="Inicio de <%= infoModulo.nombre %>">
        <img
          src="/assets/aistudio/WhatsApp_Image_2026-10-24_at_4.01.50_PM-Photoroom_c9a67c8e.png"
          alt="Logo Comuna Socialista Carabobo 200"
          class="brand-logo"
          width="42"
          height="42"
        >
        <span class="brand-text">
          <strong>Comuna Carabobo 200</strong>
        </span>
      </a>

      <span class="modulo-actual-pill modulo-actual-pill--<%= moduloActual %>">
        <%= infoModulo.nombre %>
      </span>

      <div class="app-header-right">
        <% if (moduloActual !== 'portal') { %>
          <a href="/inicio" class="boton boton--mini boton--secundario">Módulos</a>
        <% } %>

        <% if (usuarioActual) { %>
          <div class="app-user">
            <span class="app-user-avatar" aria-hidden="true"><%= (usuarioActual.nombre || usuarioActual.usuario || '?').slice(0, 1).toUpperCase() %></span>
            <span class="app-user-datos">
              <strong><%= usuarioActual.nombre %></strong>
              <small><%= usuarioActual.rol === 'admin' ? 'Administrador' : 'Gestor' %></small>
            </span>
            <form method="post" action="/logout" class="logout-form">
              <button type="submit" class="boton boton--mini boton--secundario">Salir</button>
            </form>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <% if (moduloActual === 'censo') { %>
    <div class="app-contextbar">
      <div class="contenedor app-contextbar-inner">
        <nav class="nav-censo" aria-label="Secciones del módulo Socioeconómico">
          <a
            href="/censo"
            class="nav-censo-link <%= subseccionActual === 'inicio' || subseccionActual === 'censo' ? 'nav-censo-link--activo' : '' %>"
            <%= subseccionActual === 'inicio' || subseccionActual === 'censo' ? 'aria-current="page"' : '' %>
          >Inicio</a>
          <a
            href="/wizard"
            class="nav-censo-link <%= subseccionActual === 'registro' ? 'nav-censo-link--activo' : '' %>"
            <%= subseccionActual === 'registro' ? 'aria-current="page"' : '' %>
          >Registrar vivienda</a>
          <a
            href="/personas"
            class="nav-censo-link <%= subseccionActual === 'personas' ? 'nav-censo-link--activo' : '' %>"
            <%= subseccionActual === 'personas' ? 'aria-current="page"' : '' %>
          >Padrón de personas</a>
          <a
            href="/ubicacion"
            class="nav-censo-link <%= subseccionActual === 'ubicacion' ? 'nav-censo-link--activo' : '' %>"
            <%= subseccionActual === 'ubicacion' ? 'aria-current="page"' : '' %>
          >Por ubicación</a>
          <% if (esAdminActual) { %>
            <a
              href="/admin"
              class="nav-censo-link <%= subseccionActual === 'admin' ? 'nav-censo-link--activo' : '' %>"
              <%= subseccionActual === 'admin' ? 'aria-current="page"' : '' %>
            >Administración</a>
          <% } %>
        </nav>
      </div>
    </div>
  <% } else if (moduloActual === 'expedientes') { %>
    <div class="app-contextbar">
      <div class="contenedor app-contextbar-inner">
        <nav class="nav-censo" aria-label="Secciones de Expedientes Médicos">
          <a href="/expedientes-medicos" class="nav-censo-link nav-censo-link--activo" aria-current="page">Expedientes</a>
          <a href="#nuevo-expediente" class="nav-censo-link">Nuevo / Editar expediente</a>
        </nav>
      </div>
    </div>
  <% } else if (moduloActual === 'beneficios') { %>
    <div class="app-contextbar">
      <div class="contenedor app-contextbar-inner">
        <nav class="nav-censo" aria-label="Secciones de Beneficios">
          <a href="/beneficios" class="nav-censo-link nav-censo-link--activo" aria-current="page">Entregas</a>
          <a href="#nueva-entrega" class="nav-censo-link">Registrar entrega</a>
        </nav>
      </div>
    </div>
  <% } %>
</header>
