<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#ffffff">
  <title>Censo | Comuna Carabobo 200</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('partials/topbar', { activo: 'censo' }) %>

  <main class="contenedor pagina">
    <% if (ok) { %>
      <div class="alerta alerta--exito" role="status"><%= ok %></div>
    <% } %>

    <% if (error) { %>
      <div class="alerta alerta--error" role="alert"><%= error %></div>
    <% } %>

    <div class="resumen">
      <span><strong><%= stats.total || 0 %></strong> registros</span>
      <span><strong><%= stats.pendientes || 0 %></strong> pendientes</span>
      <span><strong><%= stats.sincronizados || 0 %></strong> sincronizados</span>
    </div>

    <div class="panel" id="buscador-viviendas">
      <div class="panel-head">
        <h2>Buscar Vivienda / Expediente</h2>
        <p>Busque por cédula, nombre, manzana o etapa.</p>
      </div>
      <div class="campos">
        <div class="campo campo-ancho">
          <input
            type="search"
            id="buscador-vivienda"
            name="q"
            placeholder="Cédula, nombre, manzana, etapa..."
            autocomplete="off"
          >
          <button type="button" class="boton boton--primario" id="btn-buscar-vivienda">Buscar</button>
          <a href="/wizard" class="boton boton--secundario">+ Registrar Nueva Vivienda</a>
        </div>
      </div>
      <div id="resultados-busqueda" class="tabla-scroll" style="margin-top:1rem;"></div>
    </div>

    <section class="panel" id="viviendas-dashboard">
      <div class="panel-head panel-head--fila">
        <div>
          <h2>Viviendas Censadas</h2>
          <p>Expedientes registrados por casa/vivienda.</p>
        </div>
        <div class="panel-head-acciones">
          <span class="contador" id="contador-viviendas">0</span>
          <button
            type="button"
            class="boton boton--mini boton--primario"
            id="btn-sincronizar-neon"
          >Subir a Neon</button>
          <button
            type="button"
            class="boton boton--mini boton--peligro"
            data-abrir-password
            data-accion="/registros/vaciar"
            data-titulo="Vaciar base de datos"
            data-mensaje="Se eliminarán todos los registros del censo y la numeración volverá a empezar en 1. Esta acción no se puede deshacer."
            data-texto-boton="Vaciar registros"
          >Vaciar BD</button>
        </div>
      </div>

      <div id="viviendas-vacias" class="tabla-vacia" style="display:none;">
        <strong>No hay viviendas censadas todavía.</strong>
        <span>Comience registrando su primera vivienda con el asistente de 3 pasos.</span>
      </div>

      <div class="tarjetas-grid" id="grid-viviendas"></div>
    </section>

    <section class="panel" id="personas-todas">
      <div class="panel-head panel-head--fila">
        <div>
          <h2>Todas las Personas Censadas</h2>
          <p>Listado completo de jefes de familia e integrantes, sin importar la vivienda.</p>
        </div>
        <div class="panel-head-acciones">
          <span class="contador" id="contador-personas">0</span>
        </div>
      </div>

      <div class="campos" style="margin-bottom: 1rem;">
        <div class="campo campo-ancho" style="max-width: 400px;">
          <input
            type="search"
            id="buscador-personas"
            name="q"
            placeholder="Buscar persona por cédula, nombre o comunidad..."
            autocomplete="off"
          >
        </div>
      </div>

      <div id="personas-vacias" class="tabla-vacia" style="display:none;">
        <strong>No hay personas censadas todavía.</strong>
        <span>Registre su primera vivienda con el asistente de 3 pasos.</span>
      </div>

      <div class="tabla-scroll" id="contenedor-personas">
        <table class="tabla-personas">
          <thead>
            <tr>
              <th scope="col">Tipo</th>
              <th scope="col">Cédula</th>
              <th scope="col">Apellidos y Nombres</th>
              <th scope="col">Edad</th>
              <th scope="col">Sexo</th>
              <th scope="col">Parentesco</th>
              <th scope="col">Comunidad</th>
              <th scope="col">Etapa / Manzana</th>
              <th scope="col">Dirección</th>
              <th scope="col">Número Casa</th>
              <th scope="col">Estado Neon</th>
            </tr>
          </thead>
          <tbody id="tbody-personas">
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <footer class="pie">
    <div class="contenedor">
      Comuna Socialista Carabobo 200 · Censo local
    </div>
  </footer>

  <dialog class="dialogo" id="dialogo-campo" data-abrir="<%= abrirCampo ? 'true' : 'false' %>">
    <form method="post" action="/campos" class="dialogo-form" data-bloquear>
      <div class="dialogo-head">
        <h2>Agregar campo</h2>
        <button type="button" class="cerrar" data-cerrar-dialogo aria-label="Cerrar">×</button>
      </div>

      <% if (errorCampo) { %>
        <div class="alerta alerta--error" role="alert"><%= errorCampo %></div>
      <% } %>

      <div class="campos">
        <div class="campo">
          <label for="etiqueta-campo">Nombre del campo <span class="requerido">*</span></label>
          <input
            type="text"
            id="etiqueta-campo"
            name="etiqueta"
            value="<%= valoresCampo.etiqueta || '' %>"
            maxlength="80"
            placeholder="Ej.: Discapacidad"
            required
          >
        </div>

        <div class="campo">
          <label for="tipo-campo">Tipo de campo</label>
          <select id="tipo-campo" name="tipo" required>
            <option value="text" <% if ((valoresCampo.tipo || 'text') === 'text') { %>selected<% } %>>Texto corto</option>
            <option value="textarea" <% if (valoresCampo.tipo === 'textarea') { %>selected<% } %>>Párrafo</option>
            <option value="number" <% if (valoresCampo.tipo === 'number') { %>selected<% } %>>Número</option>
            <option value="date" <% if (valoresCampo.tipo === 'date') { %>selected<% } %>>Fecha</option>
            <option value="tel" <% if (valoresCampo.tipo === 'tel') { %>selected<% } %>>Teléfono</option>
            <option value="email" <% if (valoresCampo.tipo === 'email') { %>selected<% } %>>Correo</option>
            <option value="select" <% if (valoresCampo.tipo === 'select') { %>selected<% } %>>Lista de opciones</option>
          </select>
        </div>

        <div class="campo bloque-opciones" id="bloque-opciones" <% if ((valoresCampo.tipo || 'text') !== 'select') { %>hidden<% } %>>
          <label for="opciones-campo">Opciones</label>
          <textarea
            id="opciones-campo"
            name="opciones"
            rows="3"
            placeholder="Sí&#10;No&#10;No sabe"
          ><%= valoresCampo.opciones || '' %></textarea>
          <p class="ayuda">Una opción por línea o separadas por comas.</p>
        </div>

        <label class="check">
          <input type="checkbox" name="requerido" value="1" <% if (valoresCampo.requerido) { %>checked<% } %>>
          Campo obligatorio
        </label>
      </div>

      <div class="dialogo-acciones">
        <button type="button" class="boton boton--secundario" data-cerrar-dialogo>Cancelar</button>
        <button type="submit" class="boton boton--primario">Agregar campo</button>
      </div>
    </form>
  </dialog>

  <dialog class="dialogo" id="dialogo-password">
    <form method="post" action="" id="form-password" class="dialogo-form" data-bloquear>
      <div class="dialogo-head">
        <h2 data-password-titulo>Confirmar acción</h2>
        <button type="button" class="cerrar" data-cerrar-dialogo aria-label="Cerrar">×</button>
      </div>

      <p class="dialogo-texto" data-password-mensaje></p>

      <div class="campos">
        <div class="campo">
          <label for="clave-admin">Contraseña <span class="requerido">*</span></label>
          <input
            type="password"
            id="clave-admin"
            name="clave"
            autocomplete="current-password"
            required
          >
          <p class="ayuda">Ingrese la contraseña de administración para continuar.</p>
        </div>
      </div>

      <div class="dialogo-acciones">
        <button type="button" class="boton boton--secundario" data-cerrar-dialogo>Cancelar</button>
        <button type="submit" class="boton boton--peligro" data-password-submit>Confirmar</button>
      </div>
    </form>
  </dialog>

  <script src="/app.js" defer></script>
</body>
</html>
