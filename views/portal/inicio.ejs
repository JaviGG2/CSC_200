<%
  const listaModulos = typeof modulos !== 'undefined' ? modulos : [];
  const stats = typeof resumen !== 'undefined' ? resumen : { viviendas: 0, personas: 0, expedientes: 0, beneficios: 0 };
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#ffffff">
  <title>Inicio · Módulos | Comuna Carabobo 200</title>
  <link rel="icon" type="image/png" href="/assets/aistudio/WhatsApp_Image_2026-10-24_at_4.01.50_PM-Photoroom_c9a67c8e.png">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('../partials/topbar') %>

  <main class="contenedor pagina">
    <section class="portal-inicio-hero">
      <div class="portal-inicio-brand">
        <img
          src="/assets/aistudio/WhatsApp_Image_2026-10-24_at_4.01.50_PM-Photoroom_c9a67c8e.png"
          alt="Logo Comuna Socialista Carabobo 200"
          class="brand-logo brand-logo--portal"
          width="88"
          height="88"
        >
        <div>
          <span class="eyebrow">Base de Datos Compartida · SQLite + Neon</span>
          <h1>Comuna Socialista Carabobo 200</h1>
          <p>
            Cada módulo trabaja de forma independiente con sus propios procesos y vistas, compartiendo únicamente la base de datos comunal.
          </p>
        </div>
      </div>

      <div class="portal-db-resumen" aria-label="Totales en base de datos compartida">
        <div class="portal-db-dato">
          <strong><%= stats.viviendas %></strong>
          <span>Viviendas</span>
        </div>
        <div class="portal-db-dato">
          <strong><%= stats.personas %></strong>
          <span>Personas</span>
        </div>
        <div class="portal-db-dato">
          <strong><%= stats.expedientes %></strong>
          <span>Exp. Médicos</span>
        </div>
        <div class="portal-db-dato">
          <strong><%= stats.beneficios %></strong>
          <span>Beneficios</span>
        </div>
      </div>
    </section>

    <section class="portal-grid-modulos" aria-label="Módulos disponibles">
      <% listaModulos.forEach(function (mod) { %>
        <article class="panel portal-hub-card portal-hub-card--<%= mod.clave %>">
          <div class="portal-hub-card-head">
            <span class="portal-modulo-icono" aria-hidden="true">
              <% if (mod.clave === 'socioeconomico') { %>
                <span class="material-symbols-rounded">home</span>
              <% } else if (mod.clave === 'medicos') { %>
                <span class="material-symbols-rounded">medical_services</span>
              <% } else { %>
                <span class="material-symbols-rounded">redeem</span>
              <% } %>
            </span>
            <span class="portal-modulo-etiqueta"><%= mod.etiqueta %></span>
          </div>

          <h2><%= mod.titulo %></h2>
          <p class="portal-hub-desc"><%= mod.descripcion %></p>

          <div class="portal-hub-meta">
            <% if (mod.clave === 'socioeconomico') { %>
              <span><strong><%= stats.viviendas %></strong> viviendas · <strong><%= stats.personas %></strong> personas</span>
            <% } else if (mod.clave === 'medicos') { %>
              <span><strong><%= stats.expedientes %></strong> expedientes clínicos</span>
            <% } else { %>
              <span><strong><%= stats.beneficios %></strong> entregas registradas</span>
            <% } %>
          </div>

          <a href="<%= mod.ruta %>" class="boton boton--primario boton--bloque">
            Abrir <%= mod.titulo %>
          </a>
        </article>
      <% }); %>
    </section>
  </main>

  <footer class="pie">
    <div class="contenedor">
      Comuna Socialista Carabobo 200 · Portal Modular de Módulos
    </div>
  </footer>
</body>
</html>
