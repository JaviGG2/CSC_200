    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.14",
    "@types/pg": "^8.15.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
