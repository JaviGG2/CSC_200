{
  "name": "comuna-carabobo-200",
  "version": "2.0.0",
  "private": true,
  "description": "Censo sociodemografico y medico offline para la Comuna Socialista Carabobo 200",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only server.ts",
